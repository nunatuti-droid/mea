# Kopie als .env anlegen und Werte eintragen. Diese Datei enthält KEINE echten Zugangsdaten.
APP_ENV=production            # production | staging | development
APP_DEBUG=false
APP_URL=https://mea.ghazi-online.de
APP_TIMEZONE=Europe/Berlin
APP_NOINDEX=false             # true auf der Vorschau-Umgebung

DB_HOST=localhost
DB_PORT=3306
DB_NAME=mea
DB_NAME_TEST=mea_test
DB_USER=mea
DB_PASS=

# 32 Byte, base64 – erzeugen mit: php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# E-Mail-Versand: smtp://BENUTZER:PASSWORT@HOST:587 (Sonderzeichen URL-kodieren).
# "file" schreibt Mails nur in storage/mail (Entwicklung). Leer = kein Versand, Mails warten.
MAIL_DSN=
MAIL_FROM=
MAIL_FROM_NAME=

# PayPal (Orders v2). sandbox zum Testen, live erst nach Freigabe.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

# Sicherungen: eigener Schlüssel (32 Byte, base64). Leer = abgeleitet aus APP_KEY.
# WICHTIG: Ohne diesen Schlüssel (bzw. APP_KEY) lassen sich Sicherungen nicht öffnen.
# Getrennt von den Sicherungen aufbewahren (z. B. Passwortmanager).
BACKUP_KEY=

# Öffentlicher Prüfschlüssel für Updates und Dateiwächter (base64, Ed25519).
# Erzeugen auf dem Entwicklungsrechner: php bin/console release:keygen <Ordner außerhalb des Projekts>
# Der geheime Schlüssel bleibt beim Entwickler und kommt nie auf den Server.
RELEASE_PUBLIC_KEY=
