# Kopie als .env anlegen und Werte eintragen. Diese Datei enthält KEINE echten Zugangsdaten.
APP_ENV=production            # production | staging | development
APP_DEBUG=false
APP_URL=https://mea.ghazi-online.de
APP_TIMEZONE=Europe/Berlin
APP_NOINDEX=false             # true auf der Vorschau-Umgebung

DB_HOST=localhost
DB_PORT=3306
DB_NAME=mea
DB_NAME_TEST=mea_test
DB_USER=mea
DB_PASS=

# 32 Byte, base64 – erzeugen mit: php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# E-Mail-Versand: smtp://BENUTZER:PASSWORT@HOST:587 (Sonderzeichen URL-kodieren).
# "file" schreibt Mails nur in storage/mail (Entwicklung). Leer = kein Versand, Mails warten.
MAIL_DSN=
MAIL_FROM=
MAIL_FROM_NAME=

# PayPal (Orders v2). sandbox zum Testen, live erst nach Freigabe.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
