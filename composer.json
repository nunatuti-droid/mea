{
    "name": "mea/website",
    "description": "MEA Bildungszentrum – Website mit Prüfungsverwaltung und Buchung",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "bacon/bacon-qr-code": "^3.1",
        "ezyang/htmlpurifier": "^4.19",
        "guzzlehttp/guzzle": "^8.3",
        "monolog/monolog": "^3.7",
        "nikic/fast-route": "^1.3",
        "robmorgan/phinx": "^0.16",
        "spomky-labs/otphp": "^11.5",
        "symfony/mailer": "^7.4",
        "twig/intl-extra": "^3.14",
        "twig/string-extra": "^3.24",
        "twig/twig": "^3.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": { "Mea\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Mea\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "platform": { "php": "8.3.6" }
    },
    "scripts": {
        "test": "phpunit"
    }
}
