{% extends 'layout/base.twig' %}
{% import 'partials/macros.twig' as ui %}
{% set seo_title = page.seo_title ?: page.title %}
{% set seo_description = page.seo_description ?: page.intro %}
{% set canonical = '/' ~ page.slug ~ '/' %}
{% block content %}
  {% include 'partials/page_hero.twig' with {title: page.title, intro: page.intro, media_id: page.hero_media_id, crumbs: [{label: page.title}], eyebrow: 'Unser Leitbild'} %}
  <section class="section"><div class="container"><div class="prose">{{ page.body_html|raw }}</div></div></section>
  {% if reviews is not empty %}
    <section class="section section--alt" id="stimmen" aria-labelledby="stimmen-title">
      <div class="container">
        <div class="section-head"><span class="eyebrow">Stimmen</span><h2 id="stimmen-title">Was unsere Teilnehmenden sagen</h2></div>
        <div class="grid grid--3">
          {% for r in reviews %}
            <figure class="quote-card reveal">{{ icon('quote') }}{% if r.rating %}{{ ui.stars(r.rating) }}{% endif %}<blockquote>„{{ r.body }}“</blockquote><figcaption><strong>{{ r.display_name }}</strong>{{ r.role_label }}</figcaption></figure>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}
  <section class="section">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Vor Ort</span><h2>Unsere Standorte</h2></div>
      <div class="grid grid--3">
        {% for l in locations %}
          <div class="card location-card reveal"><span class="card__icon">{{ icon('map-pin') }}</span><h3><a href="/standorte/{{ l.slug }}/">{{ l.name }}</a></h3><address>{{ l.street }}{% if l.address_extra %}, {{ l.address_extra }}{% endif %}<br>{{ l.postal_code }} {{ l.city }}</address></div>
        {% endfor %}
      </div>
    </div>
  </section>
  <section class="section section--alt"><div class="container">{{ ui.cta_band('Lernen Sie uns kennen', 'Wir freuen uns auf Ihre Nachricht oder Ihren Anruf und beraten Sie gerne persönlich an einem unserer Standorte.', site.company) }}</div></section>
{% endblock %}
