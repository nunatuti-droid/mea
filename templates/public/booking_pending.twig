{% extends 'layout/base.twig' %}
{% import 'partials/macros.twig' as ui %}
{% set seo_title = 'Anmeldung: ' ~ exam.public_name %}
{% set canonical = '/pruefungen/' ~ exam.slug ~ '/' %}
{% set robots_noindex = true %}
{% block content %}
  {% include 'partials/page_hero.twig' with {title: 'Anmeldung: ' ~ exam.public_name, intro: session.starts_local|format_date(pattern="EEEE, d. MMMM yyyy, HH:mm 'Uhr'", locale='de') ~ ' · ' ~ session.location_name, media_id: null, crumbs: [{label: 'Prüfungen', url: '/telc-pruefungszentrum/'}, {label: exam.public_name, url: '/pruefungen/' ~ exam.slug ~ '/'}, {label: 'Anmeldung'}]} %}
  <section class="section">
    <div class="container stack">
      <div class="notice notice--warning">{{ icon('circle-alert') }}<p><strong>Die Online-Anmeldung ist noch nicht freigeschaltet.</strong> Sie wird in der nächsten Projektphase umgesetzt (Anmeldeformular, Platzreservierung und Zahlung mit PayPal). Bis dahin melden Sie sich bitte über das Kontaktformular oder telefonisch an.</p></div>
      <div class="btn-row">
        <a class="btn" href="/kontakt/?pruefung={{ exam.public_name|url_encode }}">{{ icon('mail') }}Anmeldung per Nachricht</a>
        <a class="btn btn--secondary" href="tel:{{ site.company.phone|tel }}">{{ icon('phone') }}{{ site.company.phone_display }}</a>
      </div>
    </div>
  </section>
{% endblock %}
