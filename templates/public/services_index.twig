{% extends 'layout/base.twig' %}
{% import 'partials/macros.twig' as ui %}
{% set seo_title = page.seo_title ?? 'Leistungen – MEA Bildungszentrum' %}
{% set seo_description = page.seo_description ?? '' %}
{% set canonical = '/leistungen/' %}
{% block content %}
  {% include 'partials/page_hero.twig' with {title: page.title ?? 'Leistungen', intro: page.intro ?? '', media_id: page.hero_media_id ?? null, crumbs: [{label: 'Leistungen'}], eyebrow: 'Was wir für Sie tun'} %}
  <section class="section" aria-labelledby="alle-leistungen">
    <div class="container">
      <h2 id="alle-leistungen" class="visually-hidden">Alle Leistungen</h2>
      <div class="grid grid--3">{% for s in services %}{{ ui.service_card(s) }}{% endfor %}</div>
    </div>
  </section>
  <section class="section section--alt"><div class="container">{{ ui.cta_band('Welche Leistung passt zu Ihnen?', 'Wir beraten Sie unverbindlich und finden gemeinsam den richtigen Weg.', site.company) }}</div></section>
{% endblock %}
