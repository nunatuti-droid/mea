{% extends 'layout/base.twig' %}
{% import 'partials/macros.twig' as ui %}
{% set seo_title = page.seo_title ?? 'Standorte' %}
{% set seo_description = page.seo_description ?? '' %}
{% set canonical = '/standorte/' %}
{% block content %}
  {% include 'partials/page_hero.twig' with {title: page.title ?? 'Standorte', intro: page.intro ?? '', media_id: null, crumbs: [{label: 'Standorte'}]} %}
  <section class="section">
    <div class="container grid grid--2">
      {% for l in locations %}
        {% include 'partials/location_card.twig' with {l: l, linked: true} %}
      {% endfor %}
    </div>
  </section>
{% endblock %}
