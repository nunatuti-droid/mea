{% extends 'layout/base.twig' %}
{% import 'partials/macros.twig' as ui %}
{% set seo_title = page.seo_title ?? 'Kontakt' %}
{% set seo_description = page.seo_description ?? '' %}
{% set canonical = '/kontakt/' %}
{% macro err(errors, name) %}{% if errors[name] is defined %}<p class="field__error" id="{{ name }}-error">{{ icon('circle-alert') }}{{ errors[name] }}</p>{% endif %}{% endmacro %}
{% import _self as f %}
{% block content %}
  {% include 'partials/page_hero.twig' with {title: page.title ?? 'Kontakt', intro: page.intro ?? '', media_id: null, crumbs: [{label: 'Kontakt'}]} %}
  <section class="section">
    <div class="container contact-layout">
      <div id="formular">
        <h2>Schreiben Sie uns</h2>
        {% if sent %}
          <div class="alert alert--success" role="status">{{ icon('circle-check') }}<span>Vielen Dank! Ihre Nachricht ist bei uns angekommen. Wir melden uns schnellstmöglich.</span></div>
        {% else %}
          {% if form_error %}<div class="alert alert--error mb-0" role="alert">{{ icon('circle-alert') }}<span>{{ form_error }}</span></div>{% endif %}
          {% if errors is not empty %}
            <div class="alert alert--error" role="alert" tabindex="-1" id="form-errors">{{ icon('circle-alert') }}<span>Bitte prüfen Sie {{ errors|length == 1 ? 'das markierte Feld' : 'die ' ~ errors|length ~ ' markierten Felder' }}.</span></div>
          {% endif %}
          <form class="form mt-5" method="post" action="/kontakt/#formular" novalidate>
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <input type="hidden" name="_t" value="{{ form_started }}">
            <div class="hp" aria-hidden="true"><label for="website">Website (bitte leer lassen)</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
            <div class="form__row">
              <div class="field{{ errors.name is defined ? ' field--error' }}">
                <label for="name">Name<span class="req" aria-hidden="true">*</span></label>
                <input class="input" id="name" name="name" type="text" autocomplete="name" required maxlength="120" value="{{ values.name ?? '' }}"{% if errors.name is defined %} aria-invalid="true" aria-describedby="name-error"{% endif %}>
                {{ f.err(errors, 'name') }}
              </div>
              <div class="field{{ errors.email is defined ? ' field--error' }}">
                <label for="email">E-Mail<span class="req" aria-hidden="true">*</span></label>
                <input class="input" id="email" name="email" type="email" autocomplete="email" required maxlength="190" value="{{ values.email ?? '' }}"{% if errors.email is defined %} aria-invalid="true" aria-describedby="email-error"{% endif %}>
                {{ f.err(errors, 'email') }}
              </div>
            </div>
            <div class="form__row">
              <div class="field{{ errors.phone is defined ? ' field--error' }}">
                <label for="phone">Telefon <span class="hint">(optional, für Rückruf)</span></label>
                <input class="input" id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" value="{{ values.phone ?? '' }}"{% if errors.phone is defined %} aria-invalid="true" aria-describedby="phone-error"{% endif %}>
                {{ f.err(errors, 'phone') }}
              </div>
              <div class="field{{ errors.topic is defined ? ' field--error' }}">
                <label for="topic">Thema</label>
                <select class="select" id="topic" name="topic">
                  <option value="">Bitte wählen</option>
                  {% for k, label in topics %}<option value="{{ k }}"{% if (values.topic ?? '') == k %} selected{% endif %}>{{ label }}</option>{% endfor %}
                </select>
                {{ f.err(errors, 'topic') }}
              </div>
            </div>
            {% if locations|length > 1 %}
              <div class="field{{ errors.location is defined ? ' field--error' }}">
                <label for="location">Bevorzugter Standort <span class="hint">(optional)</span></label>
                <select class="select" id="location" name="location">
                  <option value="">Egal</option>
                  {% for l in locations %}<option value="{{ l.id }}"{% if (values.location ?? '') == l.id ~ '' %} selected{% endif %}>{{ l.short_name }}</option>{% endfor %}
                </select>
                {{ f.err(errors, 'location') }}
              </div>
            {% endif %}
            <div class="field{{ errors.message is defined ? ' field--error' }}">
              <label for="message">Ihre Nachricht<span class="req" aria-hidden="true">*</span></label>
              <textarea class="textarea" id="message" name="message" required maxlength="5000"{% if errors.message is defined %} aria-invalid="true" aria-describedby="message-error"{% endif %}>{{ values.message ?? '' }}</textarea>
              {{ f.err(errors, 'message') }}
            </div>
            <div class="field{{ errors.privacy is defined ? ' field--error' }}">
              <label class="check"><input type="checkbox" name="privacy" value="1"{% if (values.privacy ?? '') == '1' %} checked{% endif %}{% if errors.privacy is defined %} aria-invalid="true" aria-describedby="privacy-error"{% endif %}><span>Ich habe die <a href="/datenschutz/">Datenschutzhinweise</a> gelesen und bin einverstanden, dass meine Angaben zur Bearbeitung meiner Anfrage gespeichert werden.<span class="req" aria-hidden="true">*</span></span></label>
              {{ f.err(errors, 'privacy') }}
            </div>
            <p class="hint text-muted mb-0">Felder mit <span class="req" aria-hidden="true">*</span> sind Pflichtfelder.</p>
            <div><button class="btn" type="submit">{{ icon('mail') }}Nachricht senden</button></div>
          </form>
        {% endif %}
      </div>
      <aside class="stack">
        <div class="box box--brand">
          <h2 class="h-sm">Direkter Draht</h2>
          <ul class="contact-list mt-5">
            <li><span class="card__icon">{{ icon('phone') }}</span><span>Telefon<br><a class="btn-link-light" href="tel:{{ site.company.phone|tel }}">{{ site.company.phone_display }}</a></span></li>
            {% if site.company.whatsapp %}<li><span class="card__icon">{{ icon('message-circle') }}</span><span>WhatsApp<br><a class="btn-link-light" href="https://wa.me/{{ site.company.whatsapp|tel|replace({'+': ''}) }}" rel="noopener" target="_blank">{{ site.company.whatsapp_display }}</a></span></li>{% endif %}
            <li><span class="card__icon">{{ icon('mail') }}</span><span>E-Mail<br><a class="btn-link-light" href="#formular" data-m="{{ site.company.email|obfuscate }}">E-Mail-Programm öffnen</a></span></li>
          </ul>
        </div>
        {% for l in locations %}{% include 'partials/location_card.twig' with {l: l, linked: true} %}{% endfor %}
      </aside>
    </div>
  </section>
{% endblock %}
