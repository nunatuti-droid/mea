<nav class="quickbar" aria-label="Schnellzugriff">
  <a href="tel:{{ company.phone|tel }}">{{ icon('phone') }}{{ txt('quickbar.call') }}</a>
  {% if company.whatsapp %}<a href="https://wa.me/{{ company.whatsapp|tel|replace({'+': ''}) }}" rel="noopener" target="_blank">{{ icon('message-circle') }}WhatsApp</a>{% else %}<a href="/kontakt/">{{ icon('mail') }}{{ txt('quickbar.contact') }}</a>{% endif %}
  <a class="quickbar__primary" href="{{ txt('quickbar.cta_url') }}">{{ icon('calendar') }}{{ txt('quickbar.cta_label') }}</a>
</nav>
