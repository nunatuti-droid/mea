{% if d.exams is not empty %}
<div{{ battr(b, 'b-prices') }}>
  <div class="table-wrap">
    <table class="table table--stack">
      <caption class="visually-hidden">Prüfungsgebühren</caption>
      <thead><tr><th scope="col">Prüfung</th><th scope="col">Niveau</th><th scope="col">Nächster Termin</th><th scope="col" class="num">Grundpreis</th></tr></thead>
      <tbody>
        {% for e in d.exams %}
          <tr>
            <th scope="row"><a href="/pruefungen/{{ e.slug }}/">{{ e.public_name }}</a></th>
            <td data-label="Niveau">{{ e.level_label }}</td>
            <td data-label="Nächster Termin">{{ e.next_session ? e.next_session.starts_local|format_date('medium', locale='de') ~ ', ' ~ e.next_session.location_short : 'derzeit keiner' }}</td>
            <td class="num" data-label="Grundpreis">{{ e.from_price ? e.from_price.total_cents|money(e.from_price.currency) : 'Preis folgt' }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% if f.note %}<p class="text-muted mt-5">{{ f.note }}</p>{% endif %}
</div>
{% else %}
<div{{ battr(b, 'notice') }}>{{ icon('info') }}<div>{{ f.empty|raw }}</div></div>
{% endif %}
