<div{{ battr(b, 'tabs', {'data-tabs': true}) }}>
  <div class="tabs__list" role="tablist">{% for i in f.items %}<button type="button" role="tab" id="tab-{{ b.id }}-{{ loop.index }}" aria-controls="panel-{{ b.id }}-{{ loop.index }}" aria-selected="{{ loop.first ? 'true' : 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ i.title }}</button>{% endfor %}</div>
  {% for i in f.items %}<div class="tabs__panel prose" role="tabpanel" id="panel-{{ b.id }}-{{ loop.index }}" aria-labelledby="tab-{{ b.id }}-{{ loop.index }}" tabindex="0"{% if not loop.first %} hidden{% endif %}>{{ i.html|raw }}</div>{% endfor %}
</div>
