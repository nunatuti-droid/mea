{% macro err(errors, name) %}{% if errors[name] is defined %}<p class="field__error" id="{{ name }}-error">{{ icon('circle-alert') }}{{ errors[name] }}</p>{% endif %}{% endmacro %}
{% import _self as fm %}
{%- set errors = d.errors -%}{%- set values = d.values -%}
<div{{ battr(b, 'contact-form', {id: 'formular'}) }}>
  {% if f.title %}<h2{{ bedit('title') }}>{{ f.title }}</h2>{% endif %}
  {% if d.sent %}
    <div class="alert alert--success" role="status">{{ icon('circle-check') }}<span>{{ f.success }}</span></div>
  {% else %}
    {% if d.form_error %}<div class="alert alert--error mb-0" role="alert">{{ icon('circle-alert') }}<span>{{ d.form_error }}</span></div>{% endif %}
    {% if errors is not empty %}
      <div class="alert alert--error" role="alert" tabindex="-1" id="form-errors">{{ icon('circle-alert') }}<span>Bitte prüfen Sie {{ errors|length == 1 ? 'das markierte Feld' : 'die ' ~ errors|length ~ ' markierten Felder' }}.</span></div>
    {% endif %}
    <form class="form mt-5" method="post" action="/kontakt/#formular" novalidate>
      <input type="hidden" name="_csrf" value="{{ d.csrf }}">
      <input type="hidden" name="_t" value="{{ d.form_started }}">
      <div class="hp" aria-hidden="true"><label for="website">Website (bitte leer lassen)</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
      <div class="form__row">
        <div class="field{{ errors.name is defined ? ' field--error' }}">
          <label for="name">{{ f.l_name }}<span class="req" aria-hidden="true">*</span></label>
          <input class="input" id="name" name="name" type="text" autocomplete="name" required maxlength="120" value="{{ values.name ?? '' }}"{% if errors.name is defined %} aria-invalid="true" aria-describedby="name-error"{% endif %}>
          {{ fm.err(errors, 'name') }}
        </div>
        <div class="field{{ errors.email is defined ? ' field--error' }}">
          <label for="email">{{ f.l_email }}<span class="req" aria-hidden="true">*</span></label>
          <input class="input" id="email" name="email" type="email" autocomplete="email" required maxlength="190" value="{{ values.email ?? '' }}"{% if errors.email is defined %} aria-invalid="true" aria-describedby="email-error"{% endif %}>
          {{ fm.err(errors, 'email') }}
        </div>
      </div>
      <div class="form__row">
        <div class="field{{ errors.phone is defined ? ' field--error' }}">
          <label for="phone">{{ f.l_phone }} <span class="hint">(optional, für Rückruf)</span></label>
          <input class="input" id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" value="{{ values.phone ?? '' }}"{% if errors.phone is defined %} aria-invalid="true" aria-describedby="phone-error"{% endif %}>
          {{ fm.err(errors, 'phone') }}
        </div>
        <div class="field{{ errors.topic is defined ? ' field--error' }}">
          <label for="topic">{{ f.l_topic }}</label>
          <select class="select" id="topic" name="topic">
            <option value="">Bitte wählen</option>
            {% for k, label in d.topics %}<option value="{{ k }}"{% if (values.topic ?? '') == k %} selected{% endif %}>{{ label }}</option>{% endfor %}
          </select>
          {{ fm.err(errors, 'topic') }}
        </div>
      </div>
      {% if d.locations|length > 1 %}
        <div class="field{{ errors.location is defined ? ' field--error' }}">
          <label for="location">{{ f.l_location }} <span class="hint">(optional)</span></label>
          <select class="select" id="location" name="location">
            <option value="">Egal</option>
            {% for l in d.locations %}<option value="{{ l.id }}"{% if (values.location ?? '') == l.id ~ '' %} selected{% endif %}>{{ l.short_name }}</option>{% endfor %}
          </select>
          {{ fm.err(errors, 'location') }}
        </div>
      {% endif %}
      <div class="field{{ errors.message is defined ? ' field--error' }}">
        <label for="message">{{ f.l_message }}<span class="req" aria-hidden="true">*</span></label>
        <textarea class="textarea" id="message" name="message" required maxlength="5000"{% if errors.message is defined %} aria-invalid="true" aria-describedby="message-error"{% endif %}>{{ values.message ?? '' }}</textarea>
        {{ fm.err(errors, 'message') }}
      </div>
      <div class="field{{ errors.privacy is defined ? ' field--error' }}">
        <label class="check"><input type="checkbox" name="privacy" value="1"{% if (values.privacy ?? '') == '1' %} checked{% endif %}{% if errors.privacy is defined %} aria-invalid="true" aria-describedby="privacy-error"{% endif %}><span>{{ f.privacy|replace({'<p>': '', '</p>': ' '})|trim|raw }}<span class="req" aria-hidden="true">*</span></span></label>
        {{ fm.err(errors, 'privacy') }}
      </div>
      <p class="hint text-muted mb-0">Felder mit <span class="req" aria-hidden="true">*</span> sind Pflichtfelder.</p>
      <div><button class="btn" type="submit"{% if d.preview ?? false %} disabled{% endif %}>{{ icon('mail') }}{{ f.submit }}</button></div>
    </form>
  {% endif %}
</div>
