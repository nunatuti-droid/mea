<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{% block title %}{{ title ?? 'Verwaltung' }}{% endblock %} · MEA Verwaltung</title>
  <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
  <script src="{{ asset('js/admin.js') }}" defer></script>
</head>
<body class="adm">
  {{ source('admin/_icons.svg') }}
  <a class="skip" href="#inhalt">Zum Inhalt springen</a>
  {% if me is defined and me %}
  <div class="adm-shell">
    <aside class="adm-side" id="adm-nav" data-nav>
      <div class="adm-brand"><a href="/verwaltung/">MEA <span>Verwaltung</span></a></div>
      {% set nav = [
        {label: 'Übersicht', items: [
          {url: '/verwaltung/', label: 'Dashboard', icon: 'layout-dashboard', perm: 'dashboard', exact: true},
        ]},
        {label: 'Prüfungen', items: [
          {url: '/verwaltung/pruefungen/', label: 'Prüfungsarten', icon: 'award', perm: 'exams'},
          {url: '/verwaltung/pruefungskategorien/', label: 'Prüfungskategorien', icon: 'list', perm: 'exams'},
          {url: '/verwaltung/termine/', label: 'Termine', icon: 'calendar-days', perm: 'sessions'},
          {url: '/verwaltung/kalender/', label: 'Kalender', icon: 'calendar-range', perm: 'sessions'},
          {url: '/verwaltung/buchungen/', label: 'Buchungen', icon: 'ticket', perm: 'bookings'},
          {url: '/verwaltung/anbieter/', label: 'Anbieter', icon: 'badge-check', perm: 'exams'},
          {url: '/verwaltung/buchungsregeln/', label: 'Buchungsregeln', icon: 'list-checks', perm: 'exams'},
        ]},
        {label: 'Kontakt', items: [
          {url: '/verwaltung/anfragen/', label: 'Anfragen', icon: 'inbox', perm: 'inquiries'},
          {url: '/verwaltung/bewerbungen/', label: 'Bewerbungen', icon: 'file-check', perm: 'applications'},
        ]},
        {label: 'Inhalte', items: [
          {url: '/verwaltung/seiten/', label: 'Seiten', icon: 'file-text', perm: 'content'},
          {url: '/verwaltung/leistungen/', label: 'Leistungen', icon: 'briefcase', perm: 'content'},
          {url: '/verwaltung/faq/', label: 'FAQ', icon: 'info', perm: 'content'},
          {url: '/verwaltung/bewertungen/', label: 'Bewertungen', icon: 'star', perm: 'content'},
          {url: '/verwaltung/menues/', label: 'Menüs', icon: 'list', perm: 'content'},
          {url: '/verwaltung/weiterleitungen/', label: 'Weiterleitungen', icon: 'signpost', perm: 'content'},
          {url: '/verwaltung/standorte/', label: 'Standorte', icon: 'map-pin', perm: 'locations'},
          {url: '/verwaltung/medien/', label: 'Mediathek', icon: 'image', perm: 'media'},
        ]},
        {label: 'Einstellungen', items: [
          {url: '/verwaltung/einstellungen/', label: 'Firmendaten & SEO', icon: 'settings', perm: 'settings'},
          {url: '/verwaltung/email-vorlagen/', label: 'E-Mail-Vorlagen', icon: 'file-pen', perm: 'emails'},
          {url: '/verwaltung/email-protokoll/', label: 'E-Mail-Protokoll', icon: 'mail-check', perm: 'emails'},
          {url: '/verwaltung/benutzer/', label: 'Benutzer', icon: 'users', perm: 'users'},
        ]},
        {label: 'System', items: [
          {url: '/verwaltung/protokoll/', label: 'Änderungsprotokoll', icon: 'history', perm: 'audit'},
          {url: '/verwaltung/einwilligungen/', label: 'Cookie-Einwilligungen', icon: 'shield-check', perm: 'audit'},
          {url: '/verwaltung/website-status/', label: 'Website-Status', icon: 'monitor-smartphone', perm: 'system'},
          {url: '/verwaltung/sicherheit/', label: 'Sicherheit', icon: 'shield', perm: 'system'},
          {url: '/verwaltung/sicherungen/', label: 'Sicherungen', icon: 'database', perm: 'system'},
          {url: '/verwaltung/updates/', label: 'Updates', icon: 'package', perm: 'system'},
          {url: '/verwaltung/system/', label: 'Systemprüfung', icon: 'server', perm: 'system'},
        ]},
      ] %}
      <nav aria-label="Verwaltung">
        {% for group in nav %}
          {% set visible = group.items|filter(i => can[i.perm]) %}
          {% if visible is not empty %}
            {% set group_active = false %}
            {% for i in visible %}
              {% if (i.exact is defined ? current_path == i.url : current_path starts with i.url) %}{% set group_active = true %}{% endif %}
            {% endfor %}
            {% if visible|length == 1 %}
              {% set i = visible|first %}
              <ul class="adm-side__single">
                <li><a href="{{ i.url }}"{% if group_active %} aria-current="page"{% endif %}>{{ icon(i.icon) }}{{ i.label }}</a></li>
              </ul>
            {% else %}
              <details class="adm-side__group" data-nav-group="{{ group.label }}"{% if group_active %} open data-active{% endif %}>
                <summary>{{ group.label }}{{ icon('chevron-down') }}</summary>
                <ul>
                  {% for i in visible %}
                    {% set active = i.exact is defined ? current_path == i.url : current_path starts with i.url %}
                    <li><a href="{{ i.url }}"{% if active %} aria-current="page"{% endif %}>{{ icon(i.icon) }}{{ i.label }}</a></li>
                  {% endfor %}
                </ul>
              </details>
            {% endif %}
          {% endif %}
        {% endfor %}
      </nav>
    </aside>
    <div class="adm-main">
      <header class="adm-top">
        <button class="adm-menu" type="button" data-nav-toggle aria-controls="adm-nav" aria-expanded="false" aria-label="Menü">{{ icon('menu') }}</button>
        <a class="adm-top__site" href="/" target="_blank" rel="noopener">{{ icon('external-link') }}Website ansehen</a>
        <div class="adm-top__user">
          <a href="/verwaltung/konto/" aria-label="Mein Konto: {{ me.name }}">{{ icon('user') }}<span>{{ me.name }}</span><small>{{ me.role_label }}</small></a>
          <form method="post" action="/verwaltung/abmelden/">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <button class="btn btn--ghost btn--sm" type="submit">{{ icon('log-out') }}Abmelden</button>
          </form>
        </div>
      </header>
      <main id="inhalt" class="adm-content" tabindex="-1">
        {% if not site_live.online %}
          <p class="site-banner site-banner--danger">{{ icon('circle-alert') }}<span>Die Website ist offline. Besucher sehen die Wartungsseite.{% if can.system %} <a href="/verwaltung/website-status/">Ändern</a>{% endif %}</span></p>
        {% elseif not site_live.indexing %}
          <p class="site-banner">{{ icon('info') }}<span>Suchmaschinen-Indexierung ist gesperrt.{% if can.system %} <a href="/verwaltung/website-status/">Ändern</a>{% endif %}</span></p>
        {% endif %}
        {% if flash %}
          <div class="alert alert--{{ flash.type }}" role="status">{{ icon(flash.type == 'error' ? 'circle-alert' : 'circle-check') }}<p>{{ flash.message }}</p></div>
        {% endif %}
        {% block content %}{% endblock %}
      </main>
    </div>
  </div>
  {% else %}
  <main id="inhalt" class="adm-auth" tabindex="-1">
    <div class="adm-auth__card">
      <div class="adm-auth__brand">
        {% if site.company.logo_media_id ?? false %}{{ img(site.company.logo_media_id, '180px', {alt: site.company.name ?? 'MEA Bildungszentrum', loading: 'eager'}) }}{% else %}<span class="adm-auth__name">MEA</span>{% endif %}
        <span class="adm-auth__sub">Verwaltung</span>
      </div>
      {% block auth %}{% endblock %}
    </div>
  </main>
  {% endif %}
</body>
</html>
