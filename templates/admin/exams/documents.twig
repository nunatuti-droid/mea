<section class="card" id="dokumente">
  <h2 class="h3">Bilder und Dokumente</h2>
  <p class="text-muted text-sm">Zusätzliche Bilder (Galerie) oder Dokumente zum Herunterladen, z. B. Modellprüfung als PDF. Dateien laden Sie zuerst in der <a href="/verwaltung/medien/">Mediathek</a> hoch.</p>
  {% if docs is not empty %}
    <ul class="list-plain">
      {% for d in docs %}
        <li><span>{{ icon(d.kind == 'document' ? 'file-text' : 'image') }} {{ d.label ?: (d.alt_text ?: d.original_name) }} <span class="badge badge--neutral">{{ d.role == 'document' ? 'Dokument' : 'Galerie' }}</span></span>
          <form method="post" action="/verwaltung/pruefungen/{{ exam_id }}/dokumente/{{ d.id }}/entfernen/" class="inline"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="btn btn--ghost btn--sm" type="submit">{{ icon('trash-2') }}Entfernen</button></form></li>
      {% endfor %}
    </ul>
  {% endif %}
  <form method="post" action="/verwaltung/pruefungen/{{ exam_id }}/dokumente/" class="form-grid mt">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <div class="field"><label for="doc-media">Datei</label><select id="doc-media" name="media_id"><option value="">Bitte wählen</option>{% for m in all_media %}<option value="{{ m.id }}">#{{ m.id }} {{ m.kind == 'document' ? '[PDF] ' }}{{ (m.alt_text ?: m.original_name)|u.truncate(60, '…') }}</option>{% endfor %}</select></div>
    <div class="field"><label for="doc-role">Verwendung</label><select id="doc-role" name="role"><option value="gallery">Galerie-Bild</option><option value="document">Dokument zum Herunterladen</option></select></div>
    <div class="field field--wide"><label for="doc-label">Anzeigename (optional)</label><input id="doc-label" type="text" name="label" maxlength="150"></div>
    <div><button class="btn btn--ghost btn--sm" type="submit">{{ icon('plus') }}Zuordnen</button></div>
  </form>
</section>
