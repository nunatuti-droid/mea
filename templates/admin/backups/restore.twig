{% extends 'admin/layout.twig' %}
{% block content %}
  <p class="crumb"><a href="/verwaltung/sicherungen/">{{ icon('arrow-left') }}Sicherungen</a></p>
  <div class="adm-head"><div><h1>Sicherung wiederherstellen</h1></div></div>
  <section class="card card--danger card--narrow">
    <p><strong>Stand vom {{ b.created_at|utc|date('d.m.Y H:i') }}</strong> ({{ kinds[b.kind] }}, Version {{ b.app_version }})</p>
    <p>Datenbank, Bilder, Medien und Bewerbungsunterlagen werden auf diesen Stand zurückgesetzt. Programmdateien bleiben auf dem installierten Stand (dafür gibt es die Updates). Alles, was seitdem passiert ist (Buchungen, Zahlungen, Anfragen, Änderungen), geht dabei verloren.</p>
    <ul>
      <li>Vorher wird der aktuelle Stand automatisch gesichert.</li>
      <li>Während der Wiederherstellung ist die Website im Wartungsmodus.</li>
      <li>Schlägt etwas fehl, wird der vorherige Stand automatisch zurückgespielt.</li>
      <li>Danach müssen Sie sich eventuell neu anmelden.</li>
    </ul>
    {% if error %}<div class="alert alert--error" role="alert">{{ icon('circle-alert') }}<p>{{ error }}</p></div>{% endif %}
    <form method="post" action="/verwaltung/sicherungen/{{ b.id }}/wiederherstellen/" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <div class="field"><label for="confirm">Zur Bestätigung <strong>WIEDERHERSTELLEN</strong> eingeben</label><input id="confirm" name="confirm" type="text" autocomplete="off" required></div>
      <button class="btn btn--danger" type="submit">{{ icon('history') }}Jetzt wiederherstellen</button>
    </form>
  </section>
{% endblock %}
