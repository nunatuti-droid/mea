{% extends 'admin/layout.twig' %}
{% set title = 'Neues Passwort' %}
{% block auth %}
  <h1>Neues Passwort festlegen</h1>
  {% if error is defined and error %}<div class="alert alert--error" role="alert">{{ icon('circle-alert') }}<p>{{ error }}</p></div>{% endif %}
  <form method="post">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <div class="field"><label for="password">Neues Passwort</label><input id="password" type="password" name="password" autocomplete="new-password" minlength="12" required aria-describedby="pw-help"><p class="field__help" id="pw-help">Mindestens 12 Zeichen.</p></div>
    <div class="field"><label for="password_confirm">Passwort wiederholen</label><input id="password_confirm" type="password" name="password_confirm" autocomplete="new-password" required></div>
    <button class="btn btn--primary" type="submit">Passwort speichern</button>
  </form>
{% endblock %}
