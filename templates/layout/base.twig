{%- set company = site.company -%}
{%- set seo_title = seo_title ?? 'MEA Bildungszentrum' -%}
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ seo_title }}</title>
  {% if seo_description is defined and seo_description %}<meta name="description" content="{{ seo_description }}">{% endif %}
  <link rel="canonical" href="{{ base_url }}{{ canonical ?? '/' }}">
  {% if noindex or (robots_noindex ?? false) %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="de_DE">
  <meta property="og:site_name" content="{{ company.name }}">
  <meta property="og:title" content="{{ seo_title }}">
  {% if seo_description is defined and seo_description %}<meta property="og:description" content="{{ seo_description }}">{% endif %}
  <meta property="og:url" content="{{ base_url }}{{ canonical ?? '/' }}">
  {% if og_image is defined and og_image %}<meta property="og:image" content="{{ abs_url(og_image) }}">{% endif %}
  <meta name="theme-color" content="#0e3042">
  <link rel="preload" href="/assets/fonts/plus-jakarta-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ asset('css/app.css') }}">
  <link rel="icon" href="{{ media_url(company.logo_icon_media_id, 480) }}">
  {% block head %}{% endblock %}
  <script src="{{ asset('js/app.js') }}" defer></script>
</head>
<body>
  {{ source('_icons.svg') }}
  <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
  {% if site.demo_notice ?? false %}
    <div class="demo-banner" role="note">Vorschau mit Beispieldaten: Preise und Termine sind nicht echt. Die Online-Buchung folgt in Phase 4.</div>
  {% endif %}
  {% include 'partials/header.twig' %}
  <main id="inhalt" tabindex="-1">
    {% block content %}{% endblock %}
  </main>
  {% include 'partials/footer.twig' %}
  {% include 'partials/quickbar.twig' %}
  {% block schema %}{% endblock %}
</body>
</html>
